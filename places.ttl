@prefix : <https://purl.org/location/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcc: <https://purl.org/region/rcc8/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://purl.org/location/> .

<https://purl.org/location/> rdf:type owl:Ontology ;
                              owl:imports rcc: ;
                              rdfs:comment "An ontology for places and spatial relations in a story."@en ;
                              rdfs:label "Places Ontology"@en .

#################################################################
#    Object Properties
#################################################################

###  https://purl.org/location/hasPart
:hasPart rdf:type owl:ObjectProperty ;
         owl:inverseOf :isAPartOf ;
         rdf:type owl:TransitiveProperty ;
         rdfs:comment "A place that contains a smaller place within it."@en ;
         rdfs:label "has part"@en .


###  https://purl.org/location/isAPartOf
:isAPartOf rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:comment "A place that is contained within or is a part of a larger place."@en ;
           rdfs:label "is a part of"@en .


###  https://purl.org/location/isLocatedIn
:isLocatedIn rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:comment "A place that is situated within another place."@en ;
             rdfs:label "is located in"@en .


#################################################################
#    Classes
#################################################################

###  https://purl.org/location/City
:City rdf:type owl:Class ;
      rdfs:subClassOf :Settlement ;
      rdfs:comment "A large and important settlement."@en ;
      rdfs:label "City"@en .


###  https://purl.org/location/Desert
:Desert rdf:type owl:Class ;
        rdfs:subClassOf :WildArea ;
        rdfs:comment "A wild barren area with little vegetation."@en ;
        rdfs:label "Desert"@en .


###  https://purl.org/location/Forest
:Forest rdf:type owl:Class ;
        rdfs:subClassOf :WildArea ;
        rdfs:comment "A wild area covered with trees."@en ;
        rdfs:label "Forest"@en .


###  https://purl.org/location/Hill
:Hill rdf:type owl:Class ;
      rdfs:subClassOf :WildArea ;
      rdfs:comment "A naturally raised area of land, smaller than a mountain."@en ;
      rdfs:label "Hill"@en .


###  https://purl.org/location/Place
:Place rdf:type owl:Class ;
       rdfs:comment "A location where events can occur in a story."@en ;
       rdfs:label "Place"@en .


###  https://purl.org/location/Realm
:Realm rdf:type owl:Class ;
       rdfs:subClassOf :Place ;
       rdfs:comment "A kingdom or domain ruled by a king or lord."@en ;
       rdfs:label "Realm"@en .


###  https://purl.org/location/Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :Place ;
        rdfs:comment "A large geographical area that can contain other places."@en ;
        rdfs:label "Region"@en .


###  https://purl.org/location/River
:River rdf:type owl:Class ;
       rdfs:subClassOf :Place ;
       rdfs:comment "A natural flowing body of water."@en ;
       rdfs:label "River"@en .


###  https://purl.org/location/Settlement
:Settlement rdf:type owl:Class ;
            rdfs:subClassOf :Place ;
            rdfs:comment "A place where characters live and form communities."@en ;
            rdfs:label "Settlement"@en .


###  https://purl.org/location/Underground
:Underground rdf:type owl:Class ;
             rdfs:subClassOf :Place ;
             rdfs:comment "A place located beneath the surface of the earth."@en ;
             rdfs:label "Underground"@en .


###  https://purl.org/location/Valley
:Valley rdf:type owl:Class ;
        rdfs:subClassOf :WildArea ;
        rdfs:comment "A low area between hills or mountains."@en ;
        rdfs:label "Valley"@en .


###  https://purl.org/location/Village
:Village rdf:type owl:Class ;
         rdfs:subClassOf :Settlement ;
         rdfs:comment "A small settlement with few inhabitants."@en ;
         rdfs:label "Village"@en .


###  https://purl.org/location/WildArea
:WildArea rdf:type owl:Class ;
          rdfs:subClassOf :Place ;
          rdfs:comment "An uninhabited or untamed natural area."@en ;
          rdfs:label "Wild Area"@en .


#################################################################
#    Annotations
#################################################################

rcc:ntpp rdfs:comment "the first region is entirely inside the second region and their boundaries do not touch"@en .


